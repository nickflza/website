---
import { Icon } from 'astro-icon/components';

interface Props {
    name: string;
    icon: string;
    color?: 'amber' | 'emerald' | 'fuchsia' | 'indigo' | 'red';
}

const { name, icon, color = 'amber' } = Astro.props;

const styles = {
    amber: {
        border: 'border-amber-500/30',
        bg: 'bg-amber-500/10',
        text: 'text-amber-300',
        icon: 'text-amber-400'
    },
    emerald: {
        border: 'border-emerald-500/30',
        bg: 'bg-emerald-500/10',
        text: 'text-emerald-300',
        icon: 'text-emerald-400'
    },
    fuchsia: {
        border: 'border-fuchsia-500/30',
        bg: 'bg-fuchsia-500/10',
        text: 'text-fuchsia-300',
        icon: 'text-fuchsia-400'
    },
    indigo: {
        border: 'border-indigo-500/30',
        bg: 'bg-indigo-500/10',
        text: 'text-indigo-300',
        icon: 'text-indigo-400'
    },
    red: {
        border: 'border-red-500/30',
        bg: 'bg-red-500/10',
        text: 'text-red-300',
        icon: 'text-red-400'
    }
}[color];
---

<div class:list={[
    "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl border text-sm font-medium tracking-wide transition-all hover:scale-105 select-none",
    styles.border,
    styles.bg,
    styles.text
]}>
    <Icon name={icon} class:list={["w-4 h-4 shrink-0", styles.icon]} />
    <span>{name}</span>
</div>