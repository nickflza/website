---
import Logo from "../assets/logo.svg";
---

<header class="pt-8 pb-8">
    <nav
        class="mx-auto flex flex-col items-center gap-4 min-[350px]:flex-row min-[300px]:justify-between"
    >
        <div class="block">
            <a href="/" class="group inline-block">
                <div
                    class="transition-all duration-300 opacity-90 group-hover:opacity-100 group-hover:drop-shadow-[0_0_10px_rgba(232,121,249,0.4)]"
                >
                    <Logo width={"96px"} />
                </div>
            </a>
        </div>

        <ul class="flex items-center gap-6 text-lg">
            <li>
                <a
                    href="/blog"
                    class="transition-colors duration-300 text-neutral-300 hover:text-fuchsia-400"
                    >blog</a
                >
            </li>
            <li>
                <a
                    href="/about"
                    class="transition-colors duration-300 text-neutral-300 hover:text-fuchsia-400"
                    >about</a
                >
            </li>
            <li>
                <a
                    href="/contact"
                    class="transition-colors duration-300 text-neutral-300 hover:text-fuchsia-400"
                    >contact</a
                >
            </li>
        </ul>
    </nav>
</header>
