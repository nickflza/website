---
import { Icon } from "astro-icon/components";

interface Props {
    username: string;
    limit?: number;
}

const { username, limit = 4 } = Astro.props;

interface Repo {
    name: string;
    description: string | null;
    html_url: string;
    stargazers_count: number;
    language: string | null;
    fork: boolean;
}

let repos: Repo[] = [];

try {
    const headers: Record<string, string> = {
        "Accept": "application/vnd.github.v3+json",
    };

    if (import.meta.env.GITHUB_TOKEN) {
        headers["Authorization"] = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
    }

    const res = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=6`, {
        headers
    });

    if (res.ok) {
        const data: Repo[] = await res.json();
        repos = data.filter(repo => !repo.fork).slice(0, limit);
    } else {
        console.error("GitHub API Error:", await res.text());
    }
} catch (e) {
    console.error("Failed to fetch GitHub repos", e);
}

const langColors: Record<string, string> = {
    Python: "bg-amber-400",
    Java: "bg-red-400",
    Rust: "bg-fuchsia-400",
    TypeScript: "bg-blue-400",
    JavaScript: "bg-yellow-400"
};
---

<div class="mt-14 w-full max-w-xl">
    <div class="flex items-center justify-between pb-4">
        <h2 class="text-3xl font-semibold text-white">
            Latest GitHub Projects
        </h2>
        <a 
            href={`https://github.com/${username}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-semibold text-neutral-400 hover:text-fuchsia-400 transition-colors flex items-center gap-1"
        >
            View GitHub &rarr;
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {repos.length > 0 ? (
            repos.map((repo) => (
                <a 
                    href={repo.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-col justify-between rounded-xl border border-neutral-800 bg-neutral-900/70 p-4 text-neutral-200 transition-colors hover:border-fuchsia-500/40"
                >
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <span class="font-bold text-white text-base truncate">
                                {repo.name}
                            </span>
                            <div class="flex items-center gap-1 text-xs text-neutral-400 shrink-0">
                                <Icon name="mdi:star-outline" class="w-3.5 h-3.5" />
                                <span>{repo.stargazers_count}</span>
                            </div>
                        </div>
                        
                        <p class="text-xs text-neutral-400 line-clamp-2 leading-relaxed">
                            {repo.description || "No description provided."}
                        </p>
                    </div>

                    {repo.language && (
                        <div class="mt-4 flex items-center gap-1.5 text-xs text-neutral-400 font-medium">
                            <span class={`w-2 h-2 rounded-full ${langColors[repo.language] || 'bg-neutral-500'}`}></span>
                            <span>{repo.language}</span>
                        </div>
                    )}
                </a>
            ))
        ) : (
            <div class="col-span-2 p-4 rounded-xl border border-neutral-800 bg-neutral-900/70 text-center text-sm text-neutral-400">
                Unable to load repositories right now.
            </div>
        )}
    </div>
</div>