---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
    post: {
        id: string;
        slug?: string;
        data: {
            title: string;
            pubDate: Date;
            description: string;
            image?: any;
        };
        readingTime: string;
    };
}

const { post } = Astro.props;
const postPath = post.slug || post.id.split('/')[0];
---

<a 
    href={`/blog/${postPath}`} 
    class="group block overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/70 text-neutral-200 transition-all hover:border-fuchsia-500/40 shadow-md"
>
    {post.data.image && (
        <div class="w-full h-48 overflow-hidden border-b border-neutral-800">
            <Image 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
        </div>
    )}

    <div class="p-5">
        <h2 class="text-2xl font-bold text-white group-hover:text-fuchsia-300 transition-colors mb-3">
            {post.data.title}
        </h2>
        
        <div class="flex flex-wrap font-semibold items-center gap-x-6 gap-y-2 pb-3 text-neutral-300 text-sm">
            <div class="flex items-center gap-x-1.5">
                <Icon size={18} name="mdi:calendar" class="text-fuchsia-400" />
                <span>{post.data.pubDate.toLocaleDateString()}</span>
            </div>
            <div class="flex items-center gap-x-1.5">
                <Icon size={18} name="mdi:clock" class="text-fuchsia-400" />
                <span>{post.readingTime}</span>
            </div>
        </div>

        {post.data.description && (
            <p class="text-sm text-neutral-400 leading-relaxed line-clamp-2">
                {post.data.description}
            </p>
        )}
    </div>
</a>