---
import { Image } from "astro:assets";

interface Props {
    src: any;
    alt?: string;
}

const { src, alt} = Astro.props;
---

<figure class="my-4 flex flex-col items-center">
    <div class="w-full overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 flex justify-center">
        <Image 
            src={src} 
            alt={alt} 
            class="w-auto max-h-[500px] h-auto object-contain" 
        />
    </div>
    {alt && (
        <figcaption class="mt-2 text-center text-base text-neutral-300 italic">
            {alt}
        </figcaption>
    )}
</figure>