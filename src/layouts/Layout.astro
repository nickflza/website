---
// comment
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { ClientRouter } from "astro:transitions";

const fade = {
  old: {
    name: "fadeOut",
    duration: "300ms",
    easing: "ease-in",
    fillMode: "forwards",
  },
  new: {
    name: "fadeIn",
    duration: "700ms",
    easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    fillMode: "both",
  },
};

const pageFade = {
  forwards: fade,
  backwards: fade,
};
---

<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>nick's site</title>
    <ClientRouter fallback="animate" />
</head>
<body class="bg-olive-950 text-white min-h-screen flex flex-col">
    <main class="flex-grow md:w-200 mx-auto pl-8 pr-8 w-full">
        <Navbar />
        <div class="page-fade-in" transition:animate={pageFade}>
            <slot />
        </div>
    </main>
</body>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,100..900;1,100..900&display=swap");

    body {
        font-family: Geist, sans-serif;
    }

</style>
