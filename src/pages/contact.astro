---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/personal/Contact.astro";
---

<Layout>
    <div class="flex flex-col items-center py-12 px-4">
        <div class="flex flex-col items-center text-center max-w-lg">
            <h1
                class="text-4xl md:text-5xl font-black tracking-tight text-white"
            >
                find me elsewhere
            </h1>

            <p class="text-lg md:text-xl text-neutral-300 pt-4 leading-relaxed">
                you can reach me by using one of the options below.
            </p>
        </div>

        <Contact />
    </div>
</Layout>
