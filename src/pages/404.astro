---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout>
    <main
        class="flex-grow w-full flex flex-col items-center justify-center px-4 py-16"
    >
        <div class="w-full max-w-xl text-center flex flex-col items-center">
            <h1
                class="text-4xl md:text-5xl font-black tracking-tight text-white mb-4"
            >
                404
            </h1>

            <p
                class="text-lg md:text-xl text-neutral-300 max-w-lg pt-2 pb-8 leading-relaxed"
            >
                page not found
            </p>

            <Button href="/">go back home</Button>
        </div>
    </main>
</Layout>